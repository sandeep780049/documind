# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="DocuMind"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
# The docker-compose stack exposes Postgres on port 5432.
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Uploads / chunking
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.txt
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# sentence_transformers (local, default) | openai | fastembed
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Must match the model: all-MiniLM-L6-v2 -> 384, text-embedding-3-small -> 1536
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
# Only required when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# LLM / generation
# ---------------------------------------------------------------------------
# ollama (local, default) | openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120

# Only required when LLM_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Retrieval / RAG
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000
MAX_QUESTION_LENGTH=2000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma separated list of allowed browser origins. Use [] to disable CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=20/minute
